on mouseEnter
  [  0] pushint8 107 ............................ <107>
  [  3] pusharglist 1 ........................... <107>
  [  5] extcall 4 ............................... <sprite(107)>
  [  7] pushcons 0 .............................. <"me_glow">
  [  9] pusharglist 1 ........................... <"me_glow">
  [ 11] extcall 16 .............................. <cast("me_glow")>
  [ 13] setobjprop 17 ........................... sprite(107).member = cast("me_glow")
  [ 15] ret
end
