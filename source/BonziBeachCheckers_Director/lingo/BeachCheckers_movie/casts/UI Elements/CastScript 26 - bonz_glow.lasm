on mouseUp
  [  0] pushcons 0 .............................. <"woodButton">
  [  2] pusharglistnoret 1 ...................... <"woodButton">
  [  4] extcall 2 ............................... puppetSound("woodButton")
  [  6] pushint8 108 ............................ <108>
  [  9] pusharglist 1 ........................... <108>
  [ 11] extcall 4 ............................... <sprite(108)>
  [ 13] pushcons 8 .............................. <"bonz_down_glow">
  [ 15] pusharglist 1 ........................... <"bonz_down_glow">
  [ 17] extcall 16 .............................. <cast("bonz_down_glow")>
  [ 19] setobjprop 17 ........................... sprite(108).member = cast("bonz_down_glow")
  [ 21] pushint8 107 ............................ <107>
  [ 24] pusharglist 1 ........................... <107>
  [ 26] extcall 4 ............................... <sprite(107)>
  [ 28] pushcons 16 ............................. <"me">
  [ 30] pusharglist 1 ........................... <"me">
  [ 32] extcall 16 .............................. <cast("me")>
  [ 34] setobjprop 17 ........................... sprite(107).member = cast("me")
  [ 36] pushint8 109 ............................ <109>
  [ 39] pusharglist 1 ........................... <109>
  [ 41] extcall 4 ............................... <sprite(109)>
  [ 43] pushcons 24 ............................. <"Green_crab">
  [ 45] pusharglist 1 ........................... <"Green_crab">
  [ 47] extcall 16 .............................. <cast("Green_crab")>
  [ 49] setobjprop 17 ........................... sprite(109).member = cast("Green_crab")
