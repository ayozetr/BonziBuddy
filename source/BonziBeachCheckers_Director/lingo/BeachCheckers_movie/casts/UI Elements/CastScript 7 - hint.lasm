on mouseEnter
  [  0] pushint8 10 ............................. <10>
  [  3] pusharglist 1 ........................... <10>
  [  5] extcall 4 ............................... <sprite(10)>
  [  7] pushcons 0 .............................. <"hint_glow">
  [  9] pusharglist 1 ........................... <"hint_glow">
  [ 11] extcall 16 .............................. <cast("hint_glow")>
  [ 13] setobjprop 17 ........................... sprite(10).member = cast("hint_glow")
  [ 15] ret
end
