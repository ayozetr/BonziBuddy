on mouseEnter
  [  0] pushint8 11 ............................. <11>
  [  3] pusharglist 1 ........................... <11>
  [  5] extcall 4 ............................... <sprite(11)>
  [  7] pushcons 0 .............................. <"shell_down_glow">
  [  9] pusharglist 1 ........................... <"shell_down_glow">
  [ 11] extcall 16 .............................. <cast("shell_down_glow")>
  [ 13] setobjprop 17 ........................... sprite(11).member = cast("shell_down_glow")
  [ 15] ret
end
