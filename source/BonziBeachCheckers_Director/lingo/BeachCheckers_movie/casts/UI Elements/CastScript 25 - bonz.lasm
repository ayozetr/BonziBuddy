on mouseEnter
  [  0] pushint8 108 ............................ <108>
  [  3] pusharglist 1 ........................... <108>
  [  5] extcall 4 ............................... <sprite(108)>
  [  7] pushcons 0 .............................. <"bonz_glow">
  [  9] pusharglist 1 ........................... <"bonz_glow">
  [ 11] extcall 16 .............................. <cast("bonz_glow")>
  [ 13] setobjprop 17 ........................... sprite(108).member = cast("bonz_glow")
  [ 15] ret
end
