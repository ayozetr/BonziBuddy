on mouseUp me
  [  0] pushcons 0 .............................. <"beachButton">
  [  2] pusharglistnoret 1 ...................... <"beachButton">
  [  4] extcall 2 ............................... puppetSound("beachButton")
  [  6] pushint8 2 .............................. <2>
  [  9] pusharglist 1 ........................... <2>
  [ 11] extcall 4 ............................... <sprite(2)>
  [ 13] pusharglistnoret 1 ...................... <sprite(2)>
  [ 15] extcall 37 .............................. ShutDownGame(sprite(2))
  [ 18] pusharglistnoret 0 ...................... <>
  [ 20] extcall 38 .............................. quit()
  [ 23] ret
end

on mouseLeave me
  [  0] pushint8 12 ............................. <12>
  [  3] pusharglist 1 ........................... <12>
  [  5] extcall 4 ............................... <sprite(12)>
  [  7] pushcons 8 .............................. <"quit">
  [  9] pusharglist 1 ........................... <"quit">
  [ 11] extcall 16 .............................. <cast("quit")>
  [ 13] setobjprop 17 ........................... sprite(12).member = cast("quit")
  [ 15] ret
end
