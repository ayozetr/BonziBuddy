on mouseEnter me
  [  0] pushint8 10 ............................. <10>
  [  3] pusharglist 1 ........................... <10>
  [  5] extcall 4 ............................... <sprite(10)>
  [  7] pushcons 0 .............................. <"options_glow">
  [  9] pusharglist 1 ........................... <"options_glow">
  [ 11] extcall 16 .............................. <cast("options_glow")>
  [ 13] setobjprop 17 ........................... sprite(10).member = cast("options_glow")
  [ 15] ret
end
