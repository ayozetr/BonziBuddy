on mouseEnter
  [  0] pushint8 106 ............................ <106>
  [  3] pusharglist 1 ........................... <106>
  [  5] extcall 4 ............................... <sprite(106)>
  [  7] pushcons 0 .............................. <"ok_glow">
  [  9] pusharglist 1 ........................... <"ok_glow">
  [ 11] extcall 16 .............................. <cast("ok_glow")>
  [ 13] setobjprop 17 ........................... sprite(106).member = cast("ok_glow")
  [ 15] ret
end

on mouseUp
  [  0] pushint8 104 ............................ <104>
  [  3] setlocal 0 .............................. IntX = 104
  [  5] getlocal 0 .............................. <IntX>
  [  7] pushint8 111 ............................ <111>
  [ 10] lteq .................................... <IntX <= 111>
  [ 11] jmpifz [ 33] ............................ repeat while IntX <= 111
  [ 14] getlocal 0 .............................. <IntX>
  [ 16] pusharglist 1 ........................... <IntX>
  [ 18] extcall 4 ............................... <sprite(IntX)>
  [ 20] pushzero ................................ <0>
  [ 21] setobjprop 23 ........................... sprite(IntX).visible = 0
  [ 23] getlocal 0 .............................. <IntX>
  [ 25] pushint8 1 .............................. <1>
  [ 28] add ..................................... <IntX + 1>
  [ 29] setlocal 0 .............................. IntX = IntX + 1
  [ 31] endrepeat [  5]
  [ 33] pushint8 2 .............................. <2>
  [ 36] pusharglist 1 ........................... <2>
  [ 38] extcall 4 ............................... <sprite(2)>
  [ 40] pushcons 8 .............................. <"mp">
  [ 42] pusharglistnoret 2 ...................... <sprite(2), "mp">
  [ 44] extcall 39 .............................. SetOptions(sprite(2), "mp")
  [ 47] ret
end
