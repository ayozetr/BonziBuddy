on exitFrame me
  [  0] pushint8 1 .............................. <1>
  [  3] setlocal 0 .............................. IntX = 1
  [  5] getlocal 0 .............................. <IntX>
  [  7] pushint8 86 ............................. <86>
  [ 10] lteq .................................... <IntX <= 86>
  [ 11] jmpifz [ 37] ............................ repeat while IntX <= 86
  [ 14] getlocal 0 .............................. <IntX>
  [ 16] pusharglist 1 ........................... <IntX>
  [ 18] extcall 47 .............................. <sprite(IntX)>
  [ 21] pushint8 1 .............................. <1>
  [ 24] setobjprop 57 ........................... sprite(IntX).visible = 1
  [ 27] getlocal 0 .............................. <IntX>
  [ 29] pushint8 1 .............................. <1>
  [ 32] add ..................................... <IntX + 1>
  [ 33] setlocal 0 .............................. IntX = IntX + 1
  [ 35] endrepeat [  5]
  [ 37] pushint8 13 ............................. <13>
  [ 40] pusharglist 1 ........................... <13>
  [ 42] extcall 47 .............................. <sprite(13)>
  [ 45] pushzero ................................ <0>
  [ 46] setobjprop 57 ........................... sprite(13).visible = 0
  [ 49] pushint8 12 ............................. <12>
  [ 52] pusharglistnoret 1 ...................... <12>
  [ 54] extcall 100 ............................. puppetTempo(12)
  [ 57] ret
end

on enterFrame me
  [  0] pushint8 13 ............................. <13>
  [  3] pusharglist 1 ........................... <13>
  [  5] extcall 47 .............................. <sprite(13)>
  [  8] pushzero ................................ <0>
  [  9] setobjprop 57 ........................... sprite(13).visible = 0
  [ 12] ret
end
