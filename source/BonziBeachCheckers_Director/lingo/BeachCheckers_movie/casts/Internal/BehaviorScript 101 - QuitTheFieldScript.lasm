property blnDone

on exitFrame me
  [  0] getprop 102 ............................. <blnDone>
  [  3] jmpifz [ 16] ............................ if blnDone then / else
  [  6] pushcons 0 .............................. <"IntroAnim">
  [  8] pusharglistnoret 1 ...................... <"IntroAnim">
  [ 10] extcall 94 .............................. go("IntroAnim")
  [ 13] jmp [ 26]
  [ 16] pusharglist 0 ........................... <>
  [ 18] thebuiltin 98 ........................... <the frame>
  [ 21] pusharglistnoret 1 ...................... <the frame>
  [ 23] extcall 94 .............................. go(the frame)
  [ 26] ret
end

on enterFrame me
  [  0] pusharglistnoret 0 ...................... <>
