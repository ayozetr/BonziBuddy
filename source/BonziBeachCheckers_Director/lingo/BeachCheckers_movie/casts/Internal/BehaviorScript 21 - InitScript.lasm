on enterFrame me
  [  0] pushint8 120 ............................ <120>
  [  3] pusharglist 1 ........................... <120>
  [  5] extcall 47 .............................. <sprite(120)>
  [  8] pushint8 1 .............................. <1>
  [ 11] setobjprop 57 ........................... sprite(120).visible = 1
  [ 14] pushint8 13 ............................. <13>
  [ 17] pusharglist 1 ........................... <13>
  [ 19] extcall 47 .............................. <sprite(13)>
  [ 22] pushzero ................................ <0>
  [ 23] setobjprop 57 ........................... sprite(13).visible = 0
  [ 26] ret
end

on exitFrame me
  [  0] pushint8 20 ............................. <20>
  [  3] setlocal 0 .............................. IntX = 20
  [  5] getlocal 0 .............................. <IntX>
  [  7] pushint8 86 ............................. <86>
  [ 10] lteq .................................... <IntX <= 86>
  [ 11] jmpifz [ 64] ............................ repeat while IntX <= 86
  [ 14] getlocal 0 .............................. <IntX>
  [ 16] pusharglist 1 ........................... <IntX>
  [ 18] extcall 47 .............................. <sprite(IntX)>
  [ 21] pushzero ................................ <0>
  [ 22] setobjprop 57 ........................... sprite(IntX).visible = 0
  [ 25] getlocal 0 .............................. <IntX>
  [ 27] pushint8 20 ............................. <20>
  [ 30] gt ...................................... <IntX > 20>
  [ 31] getlocal 0 .............................. <IntX>
  [ 33] pushint8 45 ............................. <45>
  [ 36] lt ...................................... <IntX < 45>
  [ 37] and ..................................... <(IntX > 20) and (IntX < 45)>
  [ 38] jmpifz [ 53] ............................ if (IntX > 20) and (IntX < 45) then
  [ 41] getlocal 0 .............................. <IntX>
  [ 43] pusharglist 1 ........................... <IntX>
  [ 45] extcall 47 .............................. <sprite(IntX)>
  [ 48] pushcons 0 .............................. <"red">
  [ 50] setobjprop 48 ........................... sprite(IntX).member = "red"
  [ 53] getlocal 0 .............................. <IntX>
  [ 55] pushint8 1 .............................. <1>
  [ 58] add ..................................... <IntX + 1>
  [ 59] setlocal 0 .............................. IntX = IntX + 1
  [ 61] endrepeat [  5]
